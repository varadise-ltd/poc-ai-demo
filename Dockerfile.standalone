# 无 nginx 的独立部署；Local/Cloud 都通过 VITE_* 地址由浏览器直连。
# 如果希望 Cloud 模式使用 BACKEND_HOST，请使用 Dockerfile nginx 镜像；standalone
# 镜像不会读取或解析 BACKEND_HOST。
FROM node:20-alpine AS build
WORKDIR /app

ARG VITE_BACKEND_TARGET=local
ARG VITE_LOCAL_API_BASE=https://internal-poc-aicctv-dev.varadise.cloud
ENV VITE_BACKEND_TARGET=$VITE_BACKEND_TARGET
ENV VITE_LOCAL_API_BASE=$VITE_LOCAL_API_BASE

COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM node:20-alpine AS runtime
RUN npm install --global serve@14.2.4
WORKDIR /app
COPY --from=build --chown=node:node /app/dist ./dist
USER node
EXPOSE 5173
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD node -e "fetch('http://127.0.0.1:5173/').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"
CMD ["serve", "--single", "dist", "--listen", "tcp://0.0.0.0:5173"]