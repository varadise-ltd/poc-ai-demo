# 无 nginx 的独立部署；浏览器直接请求 VITE_API_BASE 指定的后端。
FROM node:20-alpine AS build
WORKDIR /app

ARG VITE_API_BASE=http://192.168.51.7:8000
ENV VITE_API_BASE=$VITE_API_BASE

COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM node:20-alpine AS runtime
RUN npm install --global serve@14.2.4
WORKDIR /app
COPY --from=build --chown=node:node /app/dist ./dist
USER node
EXPOSE 5173
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD node -e "fetch('http://127.0.0.1:5173/').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))"
CMD ["serve", "--single", "dist", "--listen", "tcp://0.0.0.0:5173"]