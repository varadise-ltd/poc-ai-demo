# =============================================================================
# poc-ai-demo 環境變數範本（前端 Vue3 + Vite + nginx）
# 複製為 .env 後填入真實值。
#   cp .env.example .env
#
# 注意：前端變數分兩類——
#   1. VITE_* ：建置期（npm run build）注入，只有 VITE_ 前綴才會進瀏覽器 bundle。
#   2. nginx 運行期變數：容器啟動時由 envsubst 注入 nginx 設定。
# =============================================================================

# ---------------------------------------------------------------------------
# 建置期變數（Vite）
# ---------------------------------------------------------------------------
# Cloud 前端使用同源 /api，nginx 再依 BACKEND_HOST 反代到 cloud backend。
VITE_BACKEND_TARGET=cloud
VITE_LOCAL_API_BASE=

# ---------------------------------------------------------------------------
# nginx 運行期變數（容器啟動時注入；Docker Compose / K8s env 覆寫）
# ---------------------------------------------------------------------------
# 後端主機（nginx 反代 /api/ 的目標）。
#   ★ 必須用「全限定名 FQDN」，不能用短名！nginx resolver 不會展開 search 網域。
#     K8s：<Service名>.<namespace>.svc.cluster.local
#           （例：poc-ai-service.cosmos.svc.cluster.local）
#     Docker Compose：backend（內嵌 DNS 會解析短容器名）
BACKEND_HOST=

# 容器 DNS 自動探測開關（1=開啟，由入口腳本從 /etc/resolv.conf 自動讀取集群 DNS）
# 幾乎不需要改；如需強制指定 DNS，請把此值設為「空字串」並自行提供 NGINX_LOCAL_RESOLVERS。
NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1

# 僅在關閉自動探測時手動指定的 DNS 位址（例：10.96.0.10）
NGINX_LOCAL_RESOLVERS=
