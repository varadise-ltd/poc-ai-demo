# =============================================================================
# poc-ai-demo 環境變數範本（前端 Vue3 + Vite + nginx）
# 複製為 .env 後填入真實值。
#   cp .env.example .env
#
# 注意：前端變數分兩類——
#   1. VITE_* ：建置期（npm run build）注入，只有 VITE_ 前綴才會進瀏覽器 bundle。
#   2. nginx 運行期變數：容器啟動時由 envsubst 注入 nginx 設定。
# =============================================================================

# ---------------------------------------------------------------------------
# 建置期變數（Vite）
# ---------------------------------------------------------------------------
# 唯一的路由開關，在前端建置時讀取。
VITE_BACKEND_TARGET=cloud

# Local GPU 模式：瀏覽器直連的後端位址。
VITE_LOCAL_API_BASE=https://internal-poc-aicctv-dev.varadise.cloud

# 租户默认值（前端展示层兜底）。
#   平台默认组织统一为 Varadise，**由后端下发**（GET /api/orgs 的 default_org_id，
#   方案 v1.3 决策 D2），不再有 VITE_DEFAULT_ORG_ID / VITE_DEFAULT_ORG_NAME。
#   每个 tab 只能使用 Cosmos 传入的组织 + 被授权时的 Varadise（后端计算可用集合）。
#   orgId/projectId（UUID）仅用于传输/记录；orgname/projectname 才用于展示。
VITE_DEFAULT_PROJECT_ID=default
VITE_DEFAULT_PROJECT_NAME=Default

# 本地 npm run dev 的登录配置兜底（线上用下方运行期 AUTH_* 变量，优先级更高）。
# 本地用 cmp-webapp 需 Cosmos 在 cmp-webapp 登记 http://localhost:5173/ 回调；未登记时改为 legacy。
VITE_AUTH_FLOW=cmp-webapp
VITE_AUTH_BASE_URL=https://cosmos-dev.varadise.cloud/auth
VITE_AUTH_REALM=cmp-dev
VITE_AUTH_CLIENT_ID=cmp-webapp
VITE_COSMOS_ORIGIN=https://cosmos-dev.varadise.cloud,https://cosmos.varadise.cloud
VITE_BFF_BASE_URL=

# ---------------------------------------------------------------------------
# nginx 運行期變數（使用 Dockerfile nginx 鏡像時，容器啟動時注入；Docker Compose / K8s 覆寫）
# ---------------------------------------------------------------------------
# 允许嵌入本前端的 Cosmos 母站（空格分隔多个）；DEV 用 https://cosmos-dev.varadise.cloud
# 同时作为 iframe token bridge 的 postMessage origin 白名单（不再单独配 VITE_COSMOS_ORIGIN）。
COSMOS_PARENT_ORIGIN=https://cosmos-dev.varadise.cloud https://cosmos.varadise.cloud

# ---------------------------------------------------------------------------
# Cosmos 统一登录（client = cmp-webapp）—— 运行期注入 /config.js，非机密
# 方案：deploy/Cosmos-SSO-cmp-webapp-Migration-Plan.md
# ---------------------------------------------------------------------------
# cmp-webapp = 默认（新模式）：standalone 用 keycloak-js（PKCE）登录；iframe 由 Cosmos 母站 postMessage
#              下发 token；拿到 token 立即 POST /auth/session 换同源 HttpOnly 会话
#              （后端 poc-ai-service 的 COSMOS_SSO_EXCHANGE_AZP 默认即 cmp-webapp）
# legacy     = 回滚开关：后端 /auth/login（poc-ai-demo client）
AUTH_FLOW=cmp-webapp
AUTH_BASE_URL=https://cosmos-dev.varadise.cloud/auth
AUTH_REALM=cmp-dev
AUTH_CLIENT_ID=cmp-webapp
# /auth/session、/v1/me 的地址前缀。留空 = 同源（经本容器 nginx 反代到 poc-ai-service），强烈建议留空。
# 不要填 K8s Service FQDN（浏览器无法解析）；本地开发由 vite proxy 转发。
BFF_BASE_URL=

# 後端主機（nginx 反代 /api/ 與 /auth/ 的目標）。
#   ★ 只能是**主机名**，不要带 scheme / 端口 / 路径（端口由 nginx 模板补 :8000）。
#     写成 poc-ai-service:8000 会生成 host:8000:8000，导致 /api 全部 500。
#   ★ 必須用「全限定名 FQDN」，不能用短名！nginx resolver 不會展開 search 網域。
#     K8s：<Service名>.<namespace>.svc.cluster.local
#           （例：poc-ai-service.cosmos.svc.cluster.local）
#     Docker Compose：backend（內嵌 DNS 會解析短容器名）
BACKEND_HOST=poc-ai-service.cosmos.svc.cluster.local

# 容器 DNS 自動探測開關（1=開啟，由入口腳本從 /etc/resolv.conf 自動讀取集群 DNS）
# 幾乎不需要改；如需強制指定 DNS，請把此值設為「空字串」並自行提供 NGINX_LOCAL_RESOLVERS。
NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1

# 僅在關閉自動探測時手動指定的 DNS 位址（例：10.96.0.10）
NGINX_LOCAL_RESOLVERS=
