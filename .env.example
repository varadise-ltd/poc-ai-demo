# =============================================================================
# poc-ai-demo 環境變數範本（前端 Vue3 + Vite + nginx）
# 複製為 .env 後填入真實值。
#   cp .env.example .env
#
# 注意：前端變數分兩類——
#   1. VITE_* ：建置期（npm run build）注入，只有 VITE_ 前綴才會進瀏覽器 bundle。
#   2. nginx 運行期變數：容器啟動時由 envsubst 注入 nginx 設定。
# =============================================================================

# ---------------------------------------------------------------------------
# 建置期變數（Vite）
# ---------------------------------------------------------------------------
# 唯一的路由開關，在前端建置時讀取。
VITE_BACKEND_TARGET=cloud

# Local GPU 模式：瀏覽器直連的後端位址。
VITE_LOCAL_API_BASE=https://internal-poc-aicctv-dev.varadise.cloud

# 租户默认值（前端展示层兜底）。iframe 未传入 orgId/projectId、且无 localStorage
# 缓存时，用下面的默认租户键；展示层无法从 profile-service 解析出明文名称时，
# 用默认名兜底（**绝不**在 UI 显示 UUID）。
#   orgId/projectId（UUID）仅用于传输/记录；orgname/projectname 才用于展示。
VITE_DEFAULT_ORG_ID=Varadise
VITE_DEFAULT_ORG_NAME=Varadise
VITE_DEFAULT_PROJECT_ID=default
VITE_DEFAULT_PROJECT_NAME=Default

# ---------------------------------------------------------------------------
# nginx 運行期變數（使用 Dockerfile nginx 鏡像時，容器啟動時注入；Docker Compose / K8s 覆寫）
# ---------------------------------------------------------------------------
# 後端主機（nginx 反代 /api/ 的目標）。#   ★ 只能是**主机名**，不要带 scheme / 端口 / 路径（端口由 nginx 模板补 :8000）。
#     写成 poc-ai-service:8000 会生成 host:8000:8000，导致 /api 全部 500。#   ★ 必須用「全限定名 FQDN」，不能用短名！nginx resolver 不會展開 search 網域。
#     K8s：<Service名>.<namespace>.svc.cluster.local
#           （例：poc-ai-service.cosmos.svc.cluster.local）
#     Docker Compose：backend（內嵌 DNS 會解析短容器名）
# Cloud 部署示例：BACKEND_HOST=poc-ai-service.cosmos.svc.cluster.local
BACKEND_HOST=poc-ai-service.cosmos.svc.cluster.local

# 容器 DNS 自動探測開關（1=開啟，由入口腳本從 /etc/resolv.conf 自動讀取集群 DNS）
# 幾乎不需要改；如需強制指定 DNS，請把此值設為「空字串」並自行提供 NGINX_LOCAL_RESOLVERS。
NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1

# 僅在關閉自動探測時手動指定的 DNS 位址（例：10.96.0.10）
NGINX_LOCAL_RESOLVERS=
