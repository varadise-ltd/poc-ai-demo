# AI Cam POC Center 前端 nginx 配置模板
# 说明：官方 nginx 镜像启动时会用 envsubst 处理 /etc/nginx/templates/*.template，
# 把 ${BACKEND_HOST} / ${NGINX_LOCAL_RESOLVERS} 替换为运行时的环境变量后写入
# /etc/nginx/conf.d/default.conf（只替换这两个变量，见 Dockerfile 的
# NGINX_ENVSUBST_FILTER；否则 nginx 自带的 $host/$scheme 等会被误处理）。
#   BACKEND_HOST          = 后端主机名（compose: backend；K8s: 后端 Service 名）
#                           ★ 只能是**主机名**，不要带 scheme / 端口 / 路径：
#                           端口由本模板统一补 :8000。误写 docker-entrypoint.d/
#                           05-normalize-backend-host.envsh 会归一化并告警；
#                           否则会生成 "host:8000:8000" 让 /api 全部 500。
#   NGINX_LOCAL_RESOLVERS = 容器实际 DNS，由入口脚本从 /etc/resolv.conf 自动读取：
#                           Docker Compose -> 127.0.0.11
#                           Kubernetes     -> 集群 DNS（如 10.96.0.10）
# 切勿把 resolver 写成固定的 127.0.0.11：那是 Docker 专属地址，在 K8s pod 内并不存在，
# 会导致所有 /api 请求 502（recv() failed 111: Connection refused while resolving）。
server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # 人脸图片上传（multipart）等请求体放宽到 20MB（nginx 默认 1MB 会 413）
    client_max_body_size 20m;

    # 每次部署 bundle 文件名会变（带 hash），index.html 绝不能被缓存，
    # 否则浏览器拿到旧 index.html 就永远加载旧 JS，新功能看似「没生效」。
    add_header Cache-Control "no-cache" always;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # 容器 DNS：用变量 + resolver 做「请求时解析」，而不是启动时解析。
    # 好处：1) 后端暂时不可达/尚未启动时 nginx 仍能启动（否则会因
    # "host not found in upstream" 直接退出并反复重启）；
    # 2) 后端重建换 IP 后自动重新解析（valid=10s），不会一直 502。
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
    set $backend_upstream "http://${BACKEND_HOST}:8000";

    # 后端 API 反向代理
    location /api/ {
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";

        # MJPEG 实时检测流（/api/stream）必需：关闭缓冲、超长读超时，
        # 否则 nginx 会缓存帧导致画面不实时、或 60s 后断开。
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        chunked_transfer_encoding on;

        # 后端重启/短暂不可用时返回 502 而非挂起
        proxy_connect_timeout 10s;
    }

    # SPA history 模式 fallback
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 带 hash 的静态资源可以永久缓存（文件名变了内容一定变）
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
